# Copy this file to .env for local configuration if needed.
# Do not commit real secrets or production credentials.
APP_ENV=development
HMS_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
HMS_ADMIN_EMAIL=admin@gmail.com
HMS_ADMIN_PASSWORD=change-this-before-deployment
